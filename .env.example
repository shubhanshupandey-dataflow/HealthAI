# ============================================================
#  Dental AI Receptionist - configuration
#  Copy to .env and fill in the keys marked REQUIRED.
# ============================================================

# --- LiveKit (REQUIRED, free tier) - https://cloud.livekit.io -> your project -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram (REQUIRED, free $200 credit) - speech-to-text + the British voice - https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Google Gemini (REQUIRED, free tier) - the receptionist's brain
# Free API key: https://aistudio.google.com/apikey  (no card needed)
GOOGLE_API_KEY=

# --- ...or use Vertex AI instead of the API key (needs a Google Cloud project with billing or free-trial credits)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# --- Optional extras (pick them in Settings -> AI receptionist)
# CARTESIA_API_KEY=        # Cartesia Ink-2 speech recognition + Sonic 3.6 voices - https://play.cartesia.ai/keys
# ELEVEN_API_KEY=          # ElevenLabs voices
# ANTHROPIC_API_KEY=       # Claude models (paid)
# OPENAI_API_KEY=          # OpenAI models (paid)

# --- App settings
# Server (docker compose) only: host port the backend listens on (127.0.0.1) for nginx. Default 8000.
# BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
ADMIN_EMAIL=admin@clinic.local
ADMIN_PASSWORD=admin123
JWT_SECRET=replace-with-a-long-random-string
AGENT_API_KEY=replace-with-another-long-random-string

# Explicit dispatch: set a name if several agents share one LiveKit project
# (then put the same name in your SIP dispatch rule). Leave empty = joins every new room.
AGENT_NAME=

# Noise filter on the caller's audio (LiveKit Cloud): nc = standard (default, keeps every word),
# bvc = stronger background-voice removal (can clip the start of words), off = none (use on self-hosted LiveKit).
NOISE_CANCELLATION=nc

# Upload call recordings/transcripts to LiveKit Cloud observability (off by default: patient calls are health data).
RECORD_SESSIONS=false

# Start replying before the caller finishes (faster). Set to false if you hit Gemini free-tier rate limits (429).
PREEMPTIVE_GENERATION=true

# LiveKit stops sending calls to the agent when machine-wide CPU is above this (LiveKit default 0.7).
# Leave empty on a laptop (always accept calls). On a dedicated server use e.g. 0.8.
AGENT_LOAD_THRESHOLD=
